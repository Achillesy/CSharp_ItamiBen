{
  // ItamiBen 的规则文件。**程序只读它，永远不写**——所以这些注释不会被吃掉。
  //
  // 每个小目标一组规则，**组内任意一条命中就算这一秒命中**。
  // App / Title 都是正则；两个都写就两个都要中，哪个不写哪个就不设约束。
  // 标题读不到时是空字符串，写了 Title 的规则自然不命中——这就是全部语义，没有例外。
  //
  // app 名：macOS 是 localizedName（Code / Google Chrome），Windows 是进程名加后缀
  // （Code.exe），所以下面用 (\\.exe)? 同时覆盖两边。
  //
  // ⚠️ ItamiBen 自己**没有任何特例**：盯着自己的钟面就是跑偏，跟盯着别的什么一样。
  //    想让它算专注，就在下面写一条 "App": "^ItamiBen(\\.exe)?$" 的规则。
  // ⚠️ 不再用的目标写 "Disabled": true，别删——删了以后想找回来还得重写。
  "Groups": {
    "编程": {
      "Rules": [
        { "App": "^(Code|Visual Studio Code|Rider|Xcode|Terminal|iTerm2|Claude)(\\.exe)?$" },
        { "App": "^(Google Chrome|Safari|Microsoft Edge|firefox)(\\.exe)?$",
          "Title": "GitHub|Stack Overflow|docs\\.|MDN" }
      ]
    },
    "读书": {
      "Rules": [
        { "Title": "\\.pdf" },
        { "App": "^(Preview|Books|Zotero|SumatraPDF)(\\.exe)?$" }
      ]
    }
  },

  // 闹钟到点要跑的命令。**只有在钟面右键菜单里打开「Run command at alarm」之后才会跑**，
  // 而那个开关**每次启动都是关的**——持久化它是事故：重启之后被上一个会话的关机命令
  // 拍死，而你根本不知道它还开着。
  //
  // ⚠️ **永远只执行第 0 条**。这是个常用命令的收藏夹，想换就重排顺序，没有界面去选。
  // ⚠️ 一个值可以是单条字符串，也可以是一串。
  "executeCommand": {
    "macos": [
      "pmset displaysleepnow",
      "osascript -e 'tell application \"System Events\" to sleep'",
      "osascript -e 'tell application \"System Events\" to shut down'"
    ],
    "windows": [
      "rundll32.exe user32.dll,LockWorkStation",
      "rundll32.exe powrprof.dll,SetSuspendState 0,1,0",
      "shutdown /s /t 0"
    ]
  }
}
