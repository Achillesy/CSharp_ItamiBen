<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ItamiBen.App.App"
             Name="ItamiBen"
             RequestedThemeVariant="Default">

  <!-- ⚠️ Name="ItamiBen" 跟 csproj 的 AssemblyName 一样是承重的：自身豁免靠它。 -->

  <Application.Styles>
    <FluentTheme />

    <!--
      主按钮。绿 = Start，红 = Give up（危险动作，会作废整轮）。
      ⚠️ **危险那条必须写在绿色那组之后**：Avalonia 里同优先级的样式**按声明顺序生效、
         后写的赢**。挪到前面会被绿色盖掉，而且**一声不吭**。
      ⚠️ 文字用 TextControlForeground 跟着主题走，底色不跟——底色（绿/红）是**语义色**，
         反了就把「绿=专注、红=偷懒」那套拆了；而文字要解决的是「读不读得清」，
         低不透明度下按钮底色几乎不存在，文字的真实背景是卡片透出来的壁纸。
    -->
    <Style Selector="Button.start">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,9" />
    </Style>
    <Style Selector="Button.start /template/ ContentPresenter">
      <Setter Property="Background" Value="#2FA36B" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    </Style>
    <Style Selector="Button.start:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3BBA7D" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    </Style>
    <Style Selector="Button.start.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="#D6453F" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    </Style>
    <Style Selector="Button.start.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E15C56" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    </Style>

    <!--
      右上角那两个小图标。**静止时半透、悬停时变清楚**——它们压在钟面上，
      不该抢眼；要用的时候鼠标一靠就现形。
      ⚠️ 必须显式清掉 Fluent 给 Button 的背景和边框，否则悬停时会冒出一块底色。
    -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Opacity" Value="0.40" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 开着的图钉要看得清：形状（填实 vs 空心）和不透明度**双重表达**同一个状态 -->
    <Style Selector="Button.chrome.on">
      <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Styles>
</Application>
