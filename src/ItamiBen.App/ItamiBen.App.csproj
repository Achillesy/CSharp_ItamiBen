<Project Sdk="Microsoft.NET.Sdk">

  <!--
    界面层。Avalonia 12。

    ⚠️ **AssemblyName 钉死在 ItamiBen**：它就是 macOS 上 `localizedName` 报出来的字符串，
    也就是**写进 samples.db、和用户规则对匹配的那个名字**。改了不报错，只会让历史采样
    和 rules.json 里的规则对不上号。
    （2026-09-16 起它**不再**是自身豁免的依据——那个特例已经删了，见 DECISIONS C9。）

    这一层是**唯一**允许出现平台调用的地方（读前台窗口和标题、读键鼠空闲、置顶、
    播声音）。Core 保持 net10.0、零 P/Invoke。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ItamiBen</AssemblyName>
    <RootNamespace>ItamiBen.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Windows 的 exe 图标。⚠️ **tomato.ico 是 `ItamiBen` 的 export-icon 开关从
      `TomatoIcon.cs` 导出来的，不是手画的位图**——图标仍然是代码画出来的，
      改番茄的形状就去改那个文件、重导一次。
      它进仓库只是因为 MSBuild 的 ApplicationIcon 在编译时就要有这个文件在，
      而用程序自己去生成它是循环依赖。
    -->
    <ApplicationIcon>tomato.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItamiBen.Core\ItamiBen.Core.csproj" />
  </ItemGroup>

  <!--
    ⚠️ **AGENT.md 要跟程序一起发**：配置现在住在数据库里、由智能体改，而智能体得先
    找得到说明。程序启动时把它刷进运行时目录，**跟数据库放在同一个文件夹**——
    智能体拿到那个目录就同时拿到了库和用法。
    每次启动都覆盖：它是随二进制发的，**不该被改，也就不会跟代码漂开**。
  -->
  <ItemGroup>
    <Content Include="..\..\AGENT.md" Link="AGENT.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    出厂默认配置。**首次运行时拷进运行时目录**（那个目录里没有同名文件才拷）。

    ⚠️ **两个安装包都不用改**：`bundle-macos.sh` 是 `cp -R "$SRC/." Contents/MacOS/`，
    `installer/ItamiBen.iss` 是 `Source: "{#StageDir}\*" ... recursesubdirs`——
    两边都把 publish 产物整个吞进去，所以这一条 Content 同时覆盖 .dmg 和 .exe 安装包。

    ⚠️ **默认值从「代码里播种」改成「发一份文件」**（原来是 Config.EnsureSeeded）。
    改动的代价是：文件可能跟解析器漂开，而代码播种不会。对冲办法是
    `DefaultsTests` —— 它拿**真解析器**读这几份文件，漂了就编译期之后立刻红。
    别删那个测试，它是这次改动唯一的安全带。
  -->
  <ItemGroup>
    <Content Include="..\..\defaults\**" Link="defaults\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    发布时删掉所有 .pdb。

    ⚠️ **不是为了「干净」，是量出来的**：不删的话 publish 目录 127MB，删完 27MB。
    大头是 SkiaSharp / HarfBuzz 三个平台的 native 符号，单 libSkiaSharp.pdb 就上百 MB。

    本工程自己那两个 pdb 也一起删（几十 KB，无所谓）：`Log.Error` 记的是异常类型和
    消息、不是调用栈，现在没有任何东西读它们。哪天真想在 Release 日志里看行号，
    那是改 `Log.Error` 的事，**到时候再把本工程的 pdb 从这里排除**。

    ⚠️ 只在 Publish 之后跑，`dotnet build` 和调试完全不受影响。
  -->
  <Target Name="StripPdbFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PdbToStrip Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbToStrip)" ContinueOnError="true" />
    <Message Importance="high" Text="Stripped @(_PdbToStrip->Count()) .pdb file(s) (see StripPdbFromPublish in the csproj)" />
  </Target>

</Project>
