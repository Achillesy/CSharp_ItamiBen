<Project Sdk="Microsoft.NET.Sdk">

  <!--
    界面层。Avalonia 12。

    ⚠️ **AssemblyName 必须钉死在 ItamiBen**：自身豁免靠它——程序要认出「你现在看的
    前台窗口就是我自己」，否则会掉进「提醒 → 用户去看提醒 → 又判跑偏 → 再提醒」的
    死循环。改 csproj 正是这一行最容易被顺手改掉的时候。

    这一层是**唯一**允许出现平台调用的地方（读前台窗口和标题、读键鼠空闲、置顶、
    播声音）。Core 保持 net10.0、零 P/Invoke。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ItamiBen</AssemblyName>
    <RootNamespace>ItamiBen.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItamiBen.Core\ItamiBen.Core.csproj" />
  </ItemGroup>

  <!--
    随程序发一份默认 rules.json（AppData.RulesPath 的第二级）。用户自己那份在运行时
    目录里，优先级更高，**重装多少次都不会被这一份覆盖**。
  -->
  <ItemGroup>
    <Content Include="..\..\rules.json" Link="rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
