<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ItamiBen.App"
        x:Class="ItamiBen.App.MainWindow"
        Title="ItamiBen"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <!--
    ⚠️ 无边框 + 透明底是**整扇主窗口**的属性，不是另开一扇挂件——功能一个不变，
    只是外框和窗口底色没了。宽高由 layout.json 那一档决定（WindowLayout），
    XAML 里不写死，免得同一个量两处定义。

    ⚠️ 没有标题栏之后：拖窗口靠钟面（左键），关窗口靠钟面上的右键菜单。
       两者挂在同一个控件上互不影响——一个认左键、一个是 ContextMenu。
  -->

  <!--
    ⚠️ 界面文字一律英文（CLAUDE.md），目标名除外——那是用户自己在 rules.json 里写的。
  -->
  <DockPanel Margin="14">

    <!--
      控件区要有一块**实心底色**垫着：窗口透明之后，按钮和文字会直接浮在桌面上，
      什么背景都可能，读不了。
      ⚠️ 底色跟内容**分成两层**：低透明度下只有底色跟着淡，按钮和文字保持实心
      ——挡住后面的是那块底色，不是细细的文字，把文字一起调淡就没法读了。
    -->
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Border Name="CardBackdrop" CornerRadius="10" />
      <StackPanel Spacing="10" Margin="12,12,12,12">

      <!-- 三段读数的文字版。⚠️ 用分钟不用秒：格子每分钟才封盘，秒级跳动是噪声（DESIGN §4.5） -->
      <TextBlock Name="Readout" FontSize="17" FontWeight="SemiBold"
                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                 Text="Pick what you are allowed to do." />

      <!-- 小目标：勾选，可多选。内容来自 rules.json -->
      <WrapPanel Name="GoalsPanel" HorizontalAlignment="Center" />

      <!-- ⚠️ 档位只有 10 / 25 / 50，别往上加（DECISIONS C6） -->
      <StackPanel Name="TierPanel" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" />

      <!-- ⚠️ 休息期间它**不变成 Start**（DECISIONS C8）：不给「一口气连干三轮」的捷径 -->
      <Button Name="ActionBtn" Content="Start" Padding="0,9"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

      <TextBlock Name="TotalsText" FontSize="12" Opacity="0.75"
                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

      <Border Name="StatusBar" CornerRadius="4" Padding="8,6">
        <DockPanel LastChildFill="True">
          <Button Name="GrantBtn" DockPanel.Dock="Right" Content="Grant…" Margin="8,0,0,0" />
          <TextBlock Name="StatusText" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      </StackPanel>
    </Grid>

    <!--
      钟面 + 叠在左上角的闹钟时刻。
      ⚠️ 标签必须 IsHitTestVisible="False"：滚轮拨针挂在 Dial 上，
         标签不能把左上角那片区域变成挡事件的东西（v3 的 E15）。
    -->
    <Grid>
      <local:DialControl Name="Dial" />
      <!-- 右上角两个小图标，跟左上角的闹钟时刻对称。⚠️ 它们在 Dial **之外**，
           所以不吃 layout.json 那一档不透明度——图标本来就半透，再叠一层就没了 -->
      <StackPanel Name="ChromeRow" Orientation="Horizontal" Spacing="0"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0">
        <Button Name="ThemeBtn" Classes="chrome" />
        <Button Name="PinBtn" Classes="chrome" />
      </StackPanel>

      <TextBlock Name="AlarmText" FontSize="18" FontWeight="Bold" Opacity="0.85"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0"
                 IsHitTestVisible="False" Text="" />

      <!--
        alarms.cron 到点的提示条，**刚好显示一分钟**（到点起、到下一个整分止）。
        ⚠️ 不要在它隐藏之后再做「清除」动作——跟盘面上其它一切一样，这是
        「这一拍该不该显示」的条件判断，不是要擦掉的状态。
      -->
      <Border Name="AlarmBanner" IsVisible="False" IsHitTestVisible="False"
              VerticalAlignment="Bottom" CornerRadius="6" Padding="10,7" Margin="0,0,0,2"
              Background="#E6D6453F">
        <TextBlock Name="AlarmBannerText" Foreground="White" FontWeight="SemiBold"
                   TextWrapping="Wrap" TextAlignment="Center" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
