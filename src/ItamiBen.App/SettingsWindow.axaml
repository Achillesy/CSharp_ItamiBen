<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ItamiBen.App.SettingsWindow"
        Title="Settings"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True">

  <!-- ⚠️ **Topmost 必须设**：主窗口可能被用户钉住（置顶），普通模态窗会**整个沉到它
       下面**——屏幕上什么都不出现，点齿轮看着像没反应。v3 2026-07-28 实际撞到过。
       模态窗本来就该压在一切之上，所以直接钉死。

       ⚠️ **CanMinimize="False" 不能省**（v3 用户报过的 bug）：这扇窗是 ShowDialog 出来
       的，最小化不只是把它藏起来——模态开着的整段时间主窗口都是禁用的，而它又
       ShowInTaskbar="False"，最小化之后任务栏里连个能点回来的条目都没有。
       净效果：主窗口上每个按钮都死了，而且看不出原因。
       ⚠️ `CanResize="False"` **不蕴含**这一条，Avalonia 的 CanMinimize 默认就是 True。 -->

  <Window.Styles>
    <!-- 一张卡 = 一个设置。⚠️ **一个字说明都没有**（v3 用户 2026-07-28 定）：
         只有标题和控件，剩下的留给猜——跟主窗口滑块不显示数字是同一条。 -->
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="22,18,22,20" Spacing="12">

    <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />

    <!-- 卡片顺序照 v3：Force Ticking 打头、Command 收尾。
         滴答是钟自己的事、最常动；Command 是唯一会对机器动手的一条，放最后。 -->
    <Border Name="CardTick" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Force ticking" />
          <ToggleSwitch Name="ForceOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off" />
        </Grid>
        <Slider Name="TickVol" Minimum="0" Maximum="100" TickFrequency="10"
                IsSnapToTickEnabled="True" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>

    <Border Name="CardFocus" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Focus complete" />
          <ToggleSwitch Name="FocusOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off" />
        </Grid>
        <ComboBox Name="FocusSound" HorizontalAlignment="Stretch" MaxDropDownHeight="300" />
      </StackPanel>
    </Border>

    <Border Name="CardRest" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Break over" />
          <ToggleSwitch Name="RestOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off" />
        </Grid>
        <ComboBox Name="RestSound" HorizontalAlignment="Stretch" MaxDropDownHeight="300" />
      </StackPanel>
    </Border>

    <Border Name="CardIdle" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Idle Warning" />
          <ToggleSwitch Name="IdleOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off" />
        </Grid>
        <ComboBox Name="IdleSound" HorizontalAlignment="Stretch" MaxDropDownHeight="300" />
      </StackPanel>
    </Border>

    <Border Name="CardAlarms" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Alarms" />
          <ToggleSwitch Name="AlarmsOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off" />
        </Grid>
        <ComboBox Name="AlarmsSound" HorizontalAlignment="Stretch" MaxDropDownHeight="300" />
      </StackPanel>
    </Border>

    <!-- ⚠️ 这张卡照 v3：开关管「到点跑命令」，下面那个音色是**开关关着时闹钟响的那一声**。
         两件事在同一张卡上，因为它们是「闹钟到点会发生什么」的两种结果，二选一。
         开着时底下那行显示到点会跑的**那一条命令原文**——这个值多半是关机命令，
         按下开关之前有权知道按的是什么。 -->
    <Border Name="CardCommand" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Command" />
          <ToggleSwitch Name="ExecuteOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off" />
        </Grid>
        <ComboBox Name="AlarmSound" HorizontalAlignment="Stretch" MaxDropDownHeight="300" />
        <TextBlock Name="CommandPreview" IsVisible="False" TextWrapping="Wrap"
                   FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.75" />
      </StackPanel>
    </Border>

    <Button Name="OpenFolder" Content="Open config folder" Margin="0,4,0,0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,7" />

    <!-- ⚠️ 红的：这一整块是利器——它最终会把一段外来 SQL 跑在你的库上。
         真正危险的那一下（窗口里的 Apply）更红。 -->
    <Button Name="ConfigureOnline" Content="Configure online…" Margin="0,2,0,0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,7"
            Background="#D6453F" Foreground="White" FontWeight="SemiBold" />
  </StackPanel>
</Window>
