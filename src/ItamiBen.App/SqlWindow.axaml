<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ItamiBen.App.SqlWindow"
        Title="Configure online"
        Width="560" Height="720"
        CanResize="True" CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True">

  <!-- ⚠️ Topmost / CanMinimize 的理由跟 SettingsWindow 那扇一样：主窗口可能被钉住，
       普通模态会沉到它下面；而最小化一扇 ShowInTaskbar=False 的模态窗 = 主窗口全禁用
       且任务栏里没有能点回来的条目。

       ⚠️ 这扇窗**允许 Resize**（另外两扇不允许）：里面是三块可编辑的长文本，
       固定高度在小屏幕上会把 Apply 按钮挤出可视区。 -->

  <Window.Styles>
    <Style Selector="TextBlock.step">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- ⚠️ 红只给 Apply 一个：**通往危险的每一步都红，红就不再有意义**。
         入口那个按钮只是打开一扇窗，它本身什么都不写。 -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#D6453F" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C13A34" />
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

    <TextBlock Grid.Row="0" Classes="step" Text="1 · Your configuration right now (edit freely before copying)" />
    <TextBox Grid.Row="1" Name="ConfigText" Classes="code" MinHeight="180" />

    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11" Opacity="0.8" Margin="0,6,0,10"
               Text="⚠ This text goes to your clipboard and then to a website. It contains your goal names, your reminder texts and the list of applications on this machine. Delete anything you would rather not share. (Window titles and per-second history are never included.)" />

    <TextBlock Grid.Row="3" Classes="step" Text="2 · What do you want changed?" />
    <TextBox Grid.Row="4" Name="RequestText" Classes="code" Height="70" TextWrapping="Wrap" />

    <Button Grid.Row="5" Name="CopyAll" Margin="0,10,0,0" Padding="0,7"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Content="Copy all  —  instructions + configuration + your request" />

    <TextBlock Grid.Row="6" Classes="step" Margin="0,16,0,4"
               Text="3 · Paste the SQL you got back" />
    <TextBox Grid.Row="7" Name="SqlText" Classes="code" Height="150" />

    <Grid Grid.Row="8" ColumnDefinitions="*,8,*" Margin="0,10,0,0">
      <Button Grid.Column="0" Name="PasteSql" Padding="0,7"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Paste SQL" />
      <Button Grid.Column="2" Name="Apply" Classes="danger" Padding="0,7"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Apply" />
    </Grid>

    <TextBlock Grid.Row="9" Name="Result" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" />
  </Grid>
</Window>
